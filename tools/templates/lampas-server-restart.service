[Unit]
Description=Lampas Minecraft Server Scheduled Restart with Warnings
Documentation=https://lampas.town
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lampasctl restart --target /home/server --service lampas-server.service
TimeoutStartSec=600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target