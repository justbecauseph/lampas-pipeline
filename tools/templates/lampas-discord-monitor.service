[Unit]
Description=Lampas Minecraft Server Discord Uptime & Status Monitor
Documentation=https://lampas.town
After=network.target lampas-server.service

[Service]
Type=simple
User=server
Group=server
WorkingDirectory=/home/server
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/server/.minecraft-env
ExecStart=/usr/bin/python3 /usr/local/bin/lampas-discord-monitor.py
Restart=always
RestartSec=10

# Security & sandbox limits
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target