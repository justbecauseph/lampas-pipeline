{
  "rules": [
    // ========================================================================
    // LAMPAS NATURAL-SPAWN TUNING
    //
    // Design goals:
    //   - Only touch vanilla mobs with low gameplay importance.
    //   - Only touch NATURAL spawns.
    //   - Only touch the vanilla Overworld.
    //   - Preserve spawners, structures, events, breeding, commands,
    //     patrols, trial spawners, modded encounters, etc.
    //   - Never blanket-filter MONSTER / CREATURE categories.
    // ========================================================================
    {
      "name": "Lampas: disable all mob spawning in Aria",
      "what": "DISALLOW_SPAWN",
      "when": {
        "dimensionId": [
          "lampas:aria"
        ]
      }
    },
    {
      "name": "Lampas: reduce natural bats by 70%",
      "what": "DISALLOW_SPAWN",
      "when": {
        "entityId": [
          "minecraft:bat"
        ],
        "dimensionId": [
          "minecraft:overworld"
        ],
        "spawnReason": [
          "NATURAL"
        ],
        "random": 0.70
      }
    },

    {
      "name": "Lampas: reduce natural glow squid by 50%",
      "what": "DISALLOW_SPAWN",
      "when": {
        "entityId": [
          "minecraft:glow_squid"
        ],
        "dimensionId": [
          "minecraft:overworld"
        ],
        "spawnReason": [
          "NATURAL"
        ],
        "random": 0.50
      }
    },

    {
      "name": "Lampas: reduce natural squid by 25%",
      "what": "DISALLOW_SPAWN",
      "when": {
        "entityId": [
          "minecraft:squid"
        ],
        "dimensionId": [
          "minecraft:overworld"
        ],
        "spawnReason": [
          "NATURAL"
        ],
        "random": 0.25
      }
    },

    {
      "name": "Lampas: reduce natural phantoms by 50%",
      "what": "DISALLOW_SPAWN",
      "when": {
        "entityId": [
          "minecraft:phantom"
        ],
        "dimensionId": [
          "minecraft:overworld"
        ],
        "spawnReason": [
          "NATURAL"
        ],
        "random": 0.50
      }
    }
  ],

  // INFO for production.
  //
  // DEBUG logs every denied spawn and can become extremely noisy.
  // TRACE should only ever be used temporarily while diagnosing rules.
  "logLevel": "INFO"
}