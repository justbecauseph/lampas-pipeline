{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lampas.town/schemas/pack.schema.json",
  "title": "Lampas Pack Configuration (pack.toml)",
  "description": "Root modpack definition specifying pack metadata, Minecraft version, mod loader, and launcher settings.",
  "type": "object",
  "required": [
    "pack",
    "loader"
  ],
  "properties": {
    "pack": {
      "type": "object",
      "required": [
        "name",
        "version",
        "minecraft"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Modpack display name."
        },
        "version": {
          "type": "string",
          "description": "Semantic release version (e.g. '2.0.32')."
        },
        "minecraft": {
          "type": "string",
          "description": "Target Minecraft version (e.g. '26.2')."
        }
      }
    },
    "loader": {
      "type": "object",
      "required": [
        "type",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fabric",
          "description": "Mod loader type."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Fabric loader version."
        }
      }
    },
    "blacklist": {
      "type": "array",
      "description": "Exact provider or descriptor identities that check-updates and validate reject unless check-updates is explicitly forced.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["scope", "id"],
            "additionalProperties": false,
            "properties": {
              "scope": { "const": "mod_id" },
              "id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
              "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          },
          {
            "type": "object",
            "required": ["scope", "provider", "id"],
            "additionalProperties": false,
            "properties": {
              "scope": { "const": "project_id" },
              "provider": { "const": "modrinth" },
              "id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
              "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          },
          {
            "type": "object",
            "required": ["scope", "provider", "id"],
            "additionalProperties": false,
            "properties": {
              "scope": { "const": "project_id" },
              "provider": { "const": "curseforge" },
              "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          },
          {
            "type": "object",
            "required": ["scope", "provider", "id"],
            "additionalProperties": false,
            "properties": {
              "scope": { "const": "version_id" },
              "provider": { "const": "modrinth" },
              "id": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
              "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          },
          {
            "type": "object",
            "required": ["scope", "provider", "id"],
            "additionalProperties": false,
            "properties": {
              "scope": { "const": "version_id" },
              "provider": { "const": "curseforge" },
              "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          }
        ]
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^https?://[^/?#]+(/[^?#]*)?$",
          "description": "Lampas Portal base URL used for manifest blob/release URLs and as the default 'publish' target (e.g. 'https://portal.lampas.town'). The --portal flag and PORTAL_BASE_URL / PACK_PORTAL_URL environment variables override it."
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Client-relative paths (as the client manifest emits them, e.g. 'options.amecs.key_modifiers.txt') shipped as seed-only defaults. The launcher places each file only when the player has no copy and never overwrites it. Each path must canonicalize under launcher rules, must exist under pack/client/ or pack/common/, and must not be a launcher-protected path other than the exact seed paths options.txt and servers.dat. The seed paths are always seeds from pack/client/ and need not be listed."
        }
      }
    },
    "launcher": {
      "type": "object",
      "properties": {
        "minimum_version": {
          "type": "string",
          "description": "Minimum required Lampas Launcher version (e.g. '1.1.0')."
        },
        "protocol": {
          "type": "integer",
          "minimum": 1,
          "description": "Required launcher capabilities protocol (e.g. 3)."
        },
        "play": {
          "type": "object",
          "properties": {
            "auto_connect": {
              "type": "boolean",
              "description": "Automatically connect to server on game launch."
            },
            "server": {
              "type": "string",
              "description": "Target SMP server address (e.g. 'play.lampas.town:25576')."
            }
          }
        },
        "resourcepacks": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of mod IDs corresponding to required resource packs."
            }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "resourcepack": {
          "type": "object",
          "properties": {
            "artifact": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "prompt": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "uuid": {
              "type": "string"
            }
          }
        },
        "resource_pack": {
          "type": "object",
          "properties": {
            "artifact": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "prompt": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "uuid": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
