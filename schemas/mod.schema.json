{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lampas.town/schemas/mod.schema.json",
  "title": "Lampas Mod Descriptor (pack/mods/*.toml)",
  "description": "Declarative mod definition file specifying side, upstream provider, and version pinning.",
  "type": "object",
  "required": [
    "name",
    "side",
    "provider"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable mod name."
    },
    "side": {
      "type": "string",
      "enum": [
        "client",
        "server",
        "both"
      ],
      "description": "Distribution side target."
    },
    "type": {
      "type": "string",
      "enum": [
        "mod",
        "shader",
        "resourcepack"
      ],
      "default": "mod",
      "description": "Artifact category."
    },
    "notes": {
      "type": "string",
      "description": "Author notes or rationale."
    },
    "sha1": {
      "type": "string",
      "description": "Optional SHA-1 hash override."
    },
    "uuid": {
      "type": "string",
      "description": "Optional UUID (e.g. for resource packs)."
    },
    "provider": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "modrinth",
            "curseforge",
            "lampas",
            "direct"
          ],
          "description": "Upstream source provider."
        },
        "project_id": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Modrinth project slug/ID (string) or CurseForge project ID (integer)."
        },
        "version_id": {
          "type": "string",
          "description": "Modrinth version ID."
        },
        "file_id": {
          "type": "integer",
          "description": "CurseForge file ID."
        },
        "file": {
          "type": "string",
          "description": "Local JAR path relative to pack/custom-jars/."
        },
        "url": {
          "type": "string",
          "description": "Direct download URL."
        },
        "sha256": {
          "type": "string",
          "description": "SHA-256 hash for direct download."
        },
        "filename": {
          "type": "string",
          "description": "Target filename for direct download."
        },
        "size": {
          "type": "integer",
          "description": "File size for direct download."
        }
      }
    }
  }
}
