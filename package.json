{
  "name": "lampas-pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "lampasctl": "bun run tools/lampasctl/src/cli.ts",
    "manifest:dual": "bun run .agents/skills/deploy-custom-jars/scripts/generate-manifests.ts",
    "build": "tsc --noEmit && bun run tools/lampasctl/scripts/build-release.ts --target host",
    "build:lampasctl": "bun run tools/lampasctl/scripts/build-release.ts --target host",
    "build:lampasctl:all": "bun run tools/lampasctl/scripts/build-release.ts --target all --package",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "smol-toml": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "bun-types": "^1.3.14",
    "typescript": "^5.8.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plus": "1.5.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1"
  }
}
